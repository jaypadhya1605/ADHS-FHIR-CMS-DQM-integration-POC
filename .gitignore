# Filled-in test collection: contains client secrets when built with -IncludeSecrets
tests/*.local.http

# Payer handoff sheets (no credential material, but environment-specific)
out/

# Load test output
loadtest/results-*.csv

# Compiled ARM
infra/**/*.json
!infra/**/*.bicepparam

# Local tooling
.venv/
venv/
__pycache__/
*.pyc
node_modules/
.vs/
.vscode/
*.user

