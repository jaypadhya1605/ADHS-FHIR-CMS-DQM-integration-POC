        </mxCell>
        <mxCell id="o4c1" value="Consumer 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1470" y="670" width="110" height="42" as="geometry" />
        </mxCell>
        <mxCell id="o4c2" value="Consumer 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1470" y="780" width="110" height="42" as="geometry" />
        </mxCell>
        <mxCell id="o4c3" value="Consumer 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1470" y="890" width="110" height="42" as="geometry" />
        </mxCell>
        <mxCell id="o4e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4s1" target="o4in"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4s2" target="o4in"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4s3" target="o4in"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4in" target="o4o1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4in" target="o4o2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4in" target="o4o3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4o1" target="o4c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4o2" target="o4c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="o4e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;" edge="1" parent="1" source="o4o3" target="o4c3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="decision" value="DECISION, 2026-08-12 — Enterprise Architecture:  &quot;separate instances for payer, will change the default from 10 to 40 ... And then within a payer, if we want to separate by different contracts, that's going to be a logical separation instead of a physical one.&quot;   Microsoft HLS: &quot;Yes.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#0B6413;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1620" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="onboard" name="3 - Payer Onboarding (SMART Backend Services)">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ot" value="Payer onboarding — the seven steps&#10;Enterprise Architecture, 2026-08-12: &quot;We have a payer. We want to give that payer access to the AHDS server. What is the process for us to set that thing up for them?&quot;" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1. Register an Entra application&#10;for THIS payer&#10;&#10;One app per payer. Granularity matters —&#10;this is the revocation unit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Issue a credential&#10;&#10;Certificate / client assertion preferred.&#10;Microsoft HLS: &quot;a secret, which I don't recommend.&quot;&#10;Private key stays in Key Vault." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Create the FHIR Group&#10;for each contract&#10;&#10;Group/{id} holds the member cohort.&#10;This is the export unit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#742774;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="110" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Tag the payer's data&#10;&#10;meta.tag = https://providence.org/fhir/contract|CT-3456&#10;Stamped automatically by the inbound APIM policy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#742774;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="110" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Add the entitlement record in APIM&#10;&#10;appId -&gt; { payer, contracts[], groups[] }&#10;NO Azure RBAC role is granted to the payer app —&#10;this is what makes bypassing the gateway impossible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. Hand the payer their connection details&#10;&#10;• token endpoint (Entra)&#10;• gateway base URL   https://&lt;apim&gt;/payera/outbound&#10;• their Group id(s)&#10;• .well-known/smart-configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="270" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Verify with the negative tests&#10;&#10;• Group/{theirs}/$export      -&gt; 202 Accepted&#10;• Group/{someone else's}/$export -&gt; 403&#10;• GET /Patient (open query)   -&gt; contract-filtered&#10;• POST /Patient (write)       -&gt; 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=none;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="270" width="410" height="110" as="geometry" />
        </mxCell>

        <mxCell id="flowT" value="Runtime flow" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="Payer client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#8A8886;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Microsoft Entra ID&#10;token endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="480" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="APIM&#10;/payera/outbound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="480" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="AHDS FHIR&#10;fhir-payera" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#742774;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="480" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Storage&#10;export/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="480" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="fe1" value="① client_credentials&#10;   + client assertion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;fontSize=9;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" value="② Bearer token&#10;   aud = FHIR url" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;fontSize=9;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" value="③ validate-jwt&#10;   entitlement lookup&#10;   token swap → MSI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;fontSize=9;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" value="④ NDJSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#605E5C;fontSize=9;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="caveat" value="CAVEAT — Microsoft HLS, 2026-08-12:  &quot;typically, it still falls short, even with 2.0 ... You're still going to have to add APIM in there.&quot;&#10;SMART scopes are coarse-grained: they narrow by RESOURCE TYPE (&quot;you can read observations ... but you can't see conditions&quot;).&#10;They cannot express &quot;only the members of contract CT-3456&quot;. That row-level rule is APIM's job, every time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#D29200;fontColor=#605E5C;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="smartScopeNote" value="Integration Engineering, 2026-08-12:  &quot;with SMART backend, does that then mean that the access is right per resource of data on our end?&quot;  Microsoft HLS: &quot;Yes.&quot;&#10;Precisely: SMART scopes gate WHICH RESOURCE TYPES a payer may read. Which ROWS of those types is decided by the Group membership and the _tag filter applied at APIM.&#10;Both layers are needed. Neither is sufficient alone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;fontColor=#243A5E;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1330" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="the403" name="4 - The $import 403 (RCA)">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rt" value="Why $import returned 403 — and why granting the user-assigned identity did nothing" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#243A5E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="badT" value="WHAT PROVIDENCE DEV HAD  (fails)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#A80000;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bf" value="FHIR service&#10;dev-fhir-ahds-inbound&#10;&#10;system-assigned: OFF&#10;user-assigned: attached" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#742774;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="buami" value="mi-pophealth-fhir-inbound-test-01&#10;324cb15a-…&#10;&#10;Storage Blob Data Contributor ✔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="300" y="105" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bsp" value="devfhirahdsworkspace/fhirservices/&#10;dev-fhir-ahds-inbound&#10;7d1e195d-…&#10;&#10;NO ROLE ✘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A80000;fontColor=#A80000;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bstore" value="devfhirinbound&#10;pdex container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="140" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b403" value="403 Forbidden&#10;&#10;&quot;Failed to get properties of blob&#10;https://devfhirinbound.blob.core.windows.net/&#10;pdex/MSSP/Group01/…/part-000001.ndjson&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A80000;strokeColor=none;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="820" y="130" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="what everyone assumed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;dashed=1;fontSize=9;" edge="1" parent="1" source="bf" target="buami"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" value="what actually happens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A80000;strokeWidth=3;fontSize=9;fontColor=#A80000;fontStyle=1;" edge="1" parent="1" source="bf" target="bsp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be3" value="GetBlobProperties" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A80000;strokeWidth=3;fontSize=9;" edge="1" parent="1" source="bsp" target="bstore"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A80000;strokeWidth=3;" edge="1" parent="1" source="bstore" target="b403"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="goodT" value="WHAT v4 DEPLOYS  (works)" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gf" value="FHIR service&#10;fhir-payera&#10;&#10;system-assigned: ON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#742774;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="355" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gsp" value="system-assigned principal&#10;&#10;Storage Blob Data Contributor ✔&#10;granted in infra/modules/rbac.bicep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gstore" value="storage account&#10;pdex container&#10;allowSharedKeyAccess=false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="360" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g202" value="202 Accepted&#10;&#10;Content-Location: …/_operations/import/{id}&#10;→ 200 OK  transactionTime, output[], error[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=none;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="820" y="360" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ge1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=3;" edge="1" parent="1" source="gf" target="gsp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=3;" edge="1" parent="1" source="gsp" target="gstore"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=3;" edge="1" parent="1" source="gstore" target="g202"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="tell" value="HOW TO TELL THE TWO APART IN 30 SECONDS&#10;&#10;A LIVE permission failure       →  StorageBlobLogs shows a GetBlobProperties with StatusCode 403 and the calling object id.&#10;A REPLAYED terminal job result  →  the poll URL is unchanged, storage sees NO request at all, and the 403 body is byte-identical.&#10;&#10;the platform lead's 2026-08-14 retest hit the second case: the new file imported (so the grant worked), while the old file kept returning the&#10;cached OperationOutcome from the job that failed the day before. Force a NEW job id to retest — copy the NDJSON to a new blob path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#D29200;fontColor=#605E5C;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1080" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
