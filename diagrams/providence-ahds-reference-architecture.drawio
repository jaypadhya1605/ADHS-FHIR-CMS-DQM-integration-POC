        </mxCell>
        <mxCell id="o2f" value="ONE shared AHDS FHIR service&#10;all payers, all contracts&#10;&#10;Isolation is a tag, not a boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A80000;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1">
