        </mxCell>
        <mxCell id="o2p" value="On-canvas annotation:  Pros — Easy setup  ·  Cons — Performance and Security&#10;Enterprise Architecture: &quot;We have PHI over there. We are only allowed to share PHI with those payers who should have&#10;access to that. So the physical separation has to be at the payer level.&quot;" style="text;html=1;align=left;fontSize=9;fontColor=#605E5C;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="594" width="700" height="46" as="geometry" />
