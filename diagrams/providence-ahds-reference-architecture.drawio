          <mxGeometry x="1570" y="568" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="o4p" value="No pros/cons annotation was legible on the recording for this quadrant.&#10;Rejected for the same reason as Option 2: the shared inbound instance co-mingles PHI from every payer,&#10;which is the exact condition Enterprise Architecture ruled out." style="text;html=1;align=left;fontSize=9;fontColor=#605E5C;fontStyle=2;" vertex="1" parent="1">
