        </mxCell>
        <mxCell id="o4t" value="OPTION 4 — shared inbound, per-payer outbound" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="890" y="570" width="600" height="20" as="geometry" />
