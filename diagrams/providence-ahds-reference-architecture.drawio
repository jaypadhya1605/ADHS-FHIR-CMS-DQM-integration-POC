        <!-- ================= callouts ================= -->
        <mxCell id="note403" value="$import authenticates as the FHIR service's OWN system-assigned identity — NOT the user-assigned identity you attach.&#10;Granting the UAMI alone produces HTTP 403 on GetBlobProperties. This is the 2026-08-13 dev failure. See infra/modules/rbac.bicep." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A80000;fontColor=#A80000;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="770" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="noteApim" value="&quot;The physical separation should be as coarse as we can get it. And then the contracts and all this stuff should be handled by APIM.&quot;&#10;— Microsoft HLS, 2026-08-12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;fontColor=#243A5E;fontSize=9;align=left;spacingLeft=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="noteBypass" value="A payer CANNOT bypass the gateway: the payer's Entra app holds no Azure RBAC role on the FHIR service, so a token presented&#10;directly to AHDS is authenticated but not authorised. Only APIM's managed identity carries the FHIR data role." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#0B6413;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="770" width="430" height="70" as="geometry" />
        </mxCell>

